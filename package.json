{
  "name": "meridian-loop",
  "version": "1.0.0",
  "private": true,
  "description": "Meridian Loop — AI-powered sustainable sourcing & commerce platform (demo)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "demo": "vite build && node --env-file-if-exists=.env server/index.js",
    "test": "node server/selftest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
