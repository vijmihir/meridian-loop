# Optional: set this to have Claude write the assistant's answers.
# Without it, Meridian Loop uses its built-in answer engine (works fully offline).
ANTHROPIC_API_KEY=
# MERIDIAN_MODEL=claude-opus-5-5
# MERIDIAN_EFFORT=low
# PORT=8787

# Email alerts. Without SMTP_URL nothing is sent: emails only appear in the app's Email alerts page.
# Gmail example (needs an app password): smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
# SMTP_URL=
# MAIL_FROM=Meridian Loop <you@gmail.com>
# For a live demo, send every alert to one inbox you can show on screen:
# DEMO_INBOX=you@gmail.com
# Where the buttons in emails should point:
# APP_URL=http://localhost:8787

# Accounts. DEMO_MODE=0 hides the one-click demo sign-in and the reset button (do this before real users).
# DEMO_MODE=1
# A long random string for signing sessions. If unset, one is generated into data/.session-secret.
# SESSION_SECRET=
